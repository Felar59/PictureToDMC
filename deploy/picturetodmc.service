[Unit]
Description=Picture to DMC (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/var/www/picturetodmc/app

# uvicorn directly rather than `python -m PythonDCA.main`: the module's
# __main__ block binds 0.0.0.0, and with no firewall on this box that would
# publish the app on 8001 alongside the nginx port. Bind to loopback instead.
ExecStart=/var/www/picturetodmc/venv/bin/uvicorn PythonDCA.main:app \
    --host 127.0.0.1 --port 8001 --workers 1

Restart=always
RestartSec=3

# One worker on purpose. PythonDCA keeps the current conversion in a module
# global (main_instance), so a second worker would answer /download with a
# different user's pattern. Do not raise this without fixing that first.

# 3.8 GB box already running emoji-art: cap this so a huge upload can't take
# the whole machine down with it.
MemoryMax=1600M
MemoryHigh=1200M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/picturetodmc

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
#
# Panneau d'administration de La Vallée des Points de Croix — quatre volets
# (journal du service, comptes, galerie, place disque).
#
#   vallee-panel
#
# The Python lives in /usr/local/lib/vallee-panel (see deploy/admin/panel/). Root is
# needed for both halves of the job: writing to the database, reading the journal.
set -euo pipefail

LIB="${VALLEE_PANEL_LIB:-/usr/local/lib/vallee-panel}"
[ -d "$LIB" ] || { echo "panneau absent : $LIB (relance deploy/admin/install.sh)"; exit 1; }
command -v python3 >/dev/null || { echo "python3 absent (apt install python3)"; exit 1; }

# TERM has to survive sudo, or curses starts up blind.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo TERM="${TERM:-xterm-256color}" python3 "$LIB" "$@"
fi
exec python3 "$LIB" "$@"
